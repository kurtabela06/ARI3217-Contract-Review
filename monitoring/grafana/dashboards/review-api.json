    {
      "id": 5,
      "title": "Successful review processing latency: rolling 5 minutes",
      "description": "Histogram estimates through response preparation, including database saving. No observations means no latency estimate.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "contract-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(contract_review_duration_seconds_bucket{job=\"contract-review\",status=\"200\"}[5m])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "contract-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(contract_review_duration_seconds_bucket{job=\"contract-review\",status=\"200\"}[5m])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "contract-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
