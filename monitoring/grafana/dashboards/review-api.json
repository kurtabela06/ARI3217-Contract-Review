{
  "uid": "contract-review-rd1",
  "title": "Contract Review \u2014 RD1 Operations",
  "description": "Operational availability, requests, errors and latency. These measurements do not establish extraction accuracy.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "RD1",
    "contract-review"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "API scrape available: 1 = up",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "contract-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"contract-review\"}",
          "legendFormat": "Available",
          "datasource": {
            "type": "prometheus",
            "uid": "contract-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
